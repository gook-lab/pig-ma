{
  "name": "pig-ma",
  "version": "0.1.0",
  "description": "FigJam-style infinite canvas library for React with rich text editing, shapes, connectors, and comments",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:lib": "vite build --mode lib && npm run build:types",
    "build:types": "tsc -p tsconfig.lib.json",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:gate": "node scripts/lint-gate.js",
    "lint:gate:update": "node scripts/lint-gate.js --update",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "peerDependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-color": "^3.19.0",
    "@tiptap/extension-font-family": "^3.19.0",
